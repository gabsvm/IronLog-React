VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: site key de reCAPTCHA v3 para Firebase App Check (vacío = desactivado)
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Solo DEV: "1" para usar el token de depuración de App Check (nunca en producción)
VITE_FIREBASE_APPCHECK_DEBUG=
# Solo DEV/test: "1" para usar los emuladores locales de Auth y Firestore
# (nunca en producción; ver vitest.integration.config.ts)
VITE_FIREBASE_EMULATOR=
VITE_FIREBASE_EMULATOR_AUTH=
VITE_FIREBASE_EMULATOR_FIRESTORE=

# Q21: historial en la nube por sesión (users/{uid}/logs/*). Apagado salvo "1".
# Desplegar las reglas de Q21 ANTES de distribuir un build con esto encendido.
VITE_CLOUD_LOGS_V2=
