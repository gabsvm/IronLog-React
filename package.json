{
  "name": "gainslab-pro",
  "private": true,
  "version": "4.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc && npx vite build && node scripts/generate-sw-precache.mjs",
    "build:strict": "npm run lint:a11y && npm run build",
    "preview": "vite preview",
    "lint:a11y": "npx eslint \"{components,views}/**/*.{ts,tsx}\" App.tsx",
    "static-build": "vite build && node scripts/generate-sw-precache.mjs",
    "cap-sync": "npx cap sync",
    "cap-add-android": "npx cap add android",
    "cap-add-ios": "npx cap add ios",
    "cap-open-android": "npx cap open android",
    "cap-open-ios": "npx cap open ios",
    "validate-android-env": "node scripts/validate-android-env.mjs",
    "validate-kong": "node --experimental-strip-types scripts/validate-kong.ts",
    "build-android": "npm run validate-android-env && npm run build && npx cap sync android",
    "build-ios": "npm run build && npx cap sync ios",
    "android-debug-apk": "npm run build-android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvas-confetti": "^1.9.2",
    "chart.js": "^4.4.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "framer-motion": "^12.40.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^5.7.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.4.35",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
