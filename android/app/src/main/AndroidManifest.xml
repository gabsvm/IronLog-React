<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Q10: no OS auto-backup. Restoring a WebView snapshot on another
         phone is unpredictable; backup is explicit (Q6 local snapshots +
         export) and cloud (Pro). To revert: set allowBackup below to true
         (API 31+ may also want android:dataExtractionRules on <application>;
         pre-31 android:fullBackupContent). -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".RestTimerReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Q9: live-notification actions (+30s / skip). Explicit intents only;
             no intent-filter, not exported, no Activity trampoline. -->
        <receiver
            android:name=".RestTimerActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Q13: workout reminder alarm target. Explicit intents only. -->
        <receiver
            android:name=".WorkoutReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Q13: re-chains the reminder after reboot. Receives the protected
             system BOOT_COMPLETED broadcast, so it must stay exported. -->
        <receiver
            android:name=".WorkoutReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exact rest-timer alarms (user-revocable; the plugin falls back to
         setAndAllowWhileIdle when not granted). NOT USE_EXACT_ALARM (Play-restricted). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Q13: re-chain workout reminders after reboot (normal permission). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
