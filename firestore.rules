rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Transition admin: prefer the `admin` custom claim; the verified owner
    // email keeps working until the claim is set. The owner MUST verify that
    // email or set the custom claim BEFORE deploying these rules, otherwise
    // the admin panel loses write access. See docs/FIREBASE_MANUAL_STEPS.md.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || (request.auth.token.email == 'gabsvm@gmail.com'
            && request.auth.token.email_verified == true)
      );
    }

    // ── Global content (templates & exercise library) ────────────────────
    match /global_templates/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /global_exercises/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Per-user data ─────────────────────────────────────────────────────
    match /users/{uid} {
      // Owner-only read on the main user document.
      allow read: if isOwner(uid);

      // Every key the client writes (see services/syncService.ts):
      // identity (email, lastSeen, uid), session (activeSession, lastUpdated)
      // and the state sections + sectionSyncMeta. Types are checked only when
      // the key is present, because identity/session/state writes carry key
      // subsets. Array caps are 2x the unconditional trims in syncService
      // (nutritionLogs/cardioSessions .slice(-60) -> 120, bodyLogs/customFoods
      // .slice(-100) -> 200); untrimmed arrays (program, exercises,
      // personalTemplates) are type-checked but not capped.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'lastSeen', 'uid', 'lastUpdated',
          'program', 'activeMeso', 'activeSession', 'config', 'exercises',
          'rpFeedback', 'nutritionLogs', 'cardioSessions', 'bodyLogs',
          'customFoods', 'personalTemplates', 'nutritionGoal', 'macroGoals',
          'userProfile', 'sectionSyncMeta'
        ])
        && (!('lastUpdated' in request.resource.data) || request.resource.data.lastUpdated is number)
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is number)
        && (!('uid' in request.resource.data) || request.resource.data.uid is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string || request.resource.data.email == null)
        && (!('program' in request.resource.data) || request.resource.data.program is list)
        && (!('activeMeso' in request.resource.data) || request.resource.data.activeMeso is map || request.resource.data.activeMeso == null)
        && (!('activeSession' in request.resource.data) || request.resource.data.activeSession is map || request.resource.data.activeSession == null)
        && (!('config' in request.resource.data) || request.resource.data.config is map)
        && (!('exercises' in request.resource.data) || request.resource.data.exercises is list)
        && (!('rpFeedback' in request.resource.data) || request.resource.data.rpFeedback is map)
        && (!('nutritionLogs' in request.resource.data) || (request.resource.data.nutritionLogs is list && request.resource.data.nutritionLogs.size() <= 120))
        && (!('cardioSessions' in request.resource.data) || (request.resource.data.cardioSessions is list && request.resource.data.cardioSessions.size() <= 120))
        && (!('bodyLogs' in request.resource.data) || (request.resource.data.bodyLogs is list && request.resource.data.bodyLogs.size() <= 200))
        && (!('customFoods' in request.resource.data) || (request.resource.data.customFoods is list && request.resource.data.customFoods.size() <= 200))
        && (!('personalTemplates' in request.resource.data) || request.resource.data.personalTemplates is list)
        && (!('nutritionGoal' in request.resource.data) || request.resource.data.nutritionGoal is map || request.resource.data.nutritionGoal == null)
        && (!('macroGoals' in request.resource.data) || request.resource.data.macroGoals is map || request.resource.data.macroGoals == null)
        && (!('userProfile' in request.resource.data) || request.resource.data.userProfile is map || request.resource.data.userProfile == null)
        && (!('sectionSyncMeta' in request.resource.data) || request.resource.data.sectionSyncMeta is map);

      // Owner account deletion (see services/accountDeletion.ts). Never reads
      // request.resource, which is null on delete.
      allow delete: if isOwner(uid);

      // Subscription is SERVER-SIDE ONLY — the owner can read but no client
      // (not even admin) can write or delete it. Writes come from the payment
      // backend. The in-app PRO manager stays blocked by design and shows its
      // own guidance when the rules deny it.
      match /data/subscription {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Only real data documents (today: history). Any other name is denied.
      // history carries exactly { logs: [...] } (see syncService.uploadStateNow,
      // which set()s without merge). The logs cap in code is conditional on
      // payload size, so rules only enforce the list type, never a count.
      match /data/{doc} {
        allow read: if isOwner(uid) && doc == 'history';
        allow create, update: if isOwner(uid)
          && doc == 'history'
          && request.resource.data.keys().hasOnly(['logs'])
          && request.resource.data.logs is list;
        allow delete: if isOwner(uid) && doc == 'history';
      }
    }

    // Explicit deny-all: anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
