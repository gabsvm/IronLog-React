  "shortcuts": [
    {
      "name": "Iniciar entreno",
      "short_name": "Entrenar",
      "description": "Retomá o empezá tu próxima sesión",
      "url": "/?action=start&source=shortcut",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Registrar comida",
      "short_name": "Comida",
      "description": "Abrí la dieta para anotar una comida",
      "url": "/?action=nutrition&source=shortcut",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Historial",
      "short_name": "Historial",
      "description": "Revisá tus sesiones anteriores",
      "url": "/?action=history&source=shortcut",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/csv",
            ".csv",
            "text/comma-separated-values",
            "text/plain"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?action=import-csv&source=file",
      "accept": {
        "text/csv": [
          ".csv"
        ]
      }
    }
  ]
}
